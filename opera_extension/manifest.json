{
  "manifest_version": 3,
  "name": "Helena Browser Controller",
  "version": "1.1",
  "description": "Permite a Helena controlar navegadores Chromium con perfil aislado",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "ws://localhost:8766/*",
    "ws://localhost:8765/*",
    "ws://127.0.0.1:8766/*",
    "ws://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Helena Controller"
  }
}